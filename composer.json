{
  "name": "cekta/framework",
  "description": "small, fast framework for create API",
  "type": "library",
  "license": "GPL-3.0-only",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  },
  "require": {
    "php": ">=8.3",
    "ext-pcntl": "*",
    "ext-posix": "*",
    "ext-pdo": "*",
    "ext-sockets": "*",
    "cekta/module": "@dev",
    "cekta/migrator": "@dev",
    "cekta/queue": "@dev",
    "cekta/routing-fastroute": "@dev",
    "cekta/di": "@stable",
    "psr/clock": "@stable",
    "psr/log": "@stable",
    "psr/container": "@stable",
    "psr/http-server-handler": "@stable",
    "psr/http-server-middleware": "@stable",
    "symfony/console": "@stable",
    "ramsey/uuid": "@stable",
    "nyholm/psr7": "@stable",
    "spiral/roadrunner-http": "@stable"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "@stable",
    "phpstan/phpstan": "@stable",
    "testo/testo": "@stable",
    "testo/bridge-infection": "@stable",
    "mockery/mockery": "@stable",
    "lcobucci/clock": "@stable",
    "infection/infection": "@stable"
  },
  "scripts": {
    "ci": [
      "@composer install",
      "@phpcs",
      "@phpstan",
      "@testo"
    ],
    "phpcs": "./vendor/bin/phpcs",
    "phpstan": "./vendor/bin/phpstan analyse --memory-limit=-1",
    "phpunit": "./vendor/bin/phpunit",
    "testo": "./vendor/bin/testo",
    "infection": "./vendor/bin/infection --show-mutations"
  },
  "autoload": {
    "psr-4": {
      "Cekta\\Framework\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cekta\\Framework\\Test\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Evgeniy Kuvshinov",
      "email": "smpl@itmywork.com"
    }
  ]
}
