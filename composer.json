{
  "name": "cekta/framework",
  "description": "small, fast framework for create API",
  "type": "library",
  "license": "GPL-3.0-only",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  },
  "require": {
    "php": ">=8.2",
    "ext-sockets": "*",
    "cekta/di": "dev-master",
    "cekta/routing-fastroute": "@dev",
    "psr/http-server-handler": "@stable",
    "psr/http-server-middleware": "@stable",
    "spiral/roadrunner-http": "@stable",
    "nyholm/psr7": "@stable",
    "symfony/console": "@stable",
    "cekta/framework-contract": "dev-master"
  },
  "require-dev": {
    "phpunit/phpunit": "@stable",
    "squizlabs/php_codesniffer": "@stable",
    "phpstan/phpstan": "@stable",
    "infection/infection": "@stable"
  },
  "scripts": {
    "test": [
      "@composer install",
      "@phpcs",
      "@phpstan",
      "@phpunit"
    ],
    "phpcs": "./vendor/bin/phpcs",
    "phpstan": "./vendor/bin/phpstan analyse --memory-limit=-1",
    "phpunit": "./vendor/bin/phpunit",
    "infection": "./vendor/bin/infection --show-mutations"
  },
  "autoload": {
    "psr-4": {
      "Cekta\\Framework\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Cekta\\Framework\\Test\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Evgeniy Kuvshinov",
      "email": "smpl@itmywork.com"
    }
  ]
}
